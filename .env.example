# ===== FILE: .env.example =====
# Template ONLY — copy to `.env` and fill real values:
#     cp .env.example .env          (Windows PowerShell: Copy-Item .env.example .env)
# `.env` is git-ignored. Never commit real keys.
# Comments sit on their own lines on purpose (portable across dotenv parsers).
# Loaded by app/config/settings.py in Module 2.

# ---------- Google Gemini (free tier via Google AI Studio) ----------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Free-tier availability and limits are per-project: confirm in AI Studio.
GEMINI_MODEL=gemini-2.5-flash
# Keep this BELOW the RPM shown for your project in AI Studio.
GEMINI_MAX_REQUESTS_PER_MINUTE=10

# ---------- Storage ----------
DATABASE_PATH=data/trendwatch.db

# ---------- Collection ----------
MAX_ITEMS_PER_SOURCE=20
REQUEST_TIMEOUT_SECONDS=15
# Optional (free): raises the GitHub API rate limit. Leave empty to skip.
GITHUB_TOKEN=

# ---------- OpenWA (local WhatsApp gateway; set up in Module 11) ----------
# Install/start it with:  python scripts/setup_openwa.py up
OPENWA_BASE_URL=http://127.0.0.1:2785
# Admin key: print it with  python scripts/setup_openwa.py key
OPENWA_API_KEY=change-me
# The session ID (a UUID) shown in the OpenWA dashboard after you create the session.
OPENWA_SESSION_ID=
# Class group chat id, ending in @g.us (lists groups: GET /api/sessions/<session id>/groups).
WHATSAPP_GROUP_ID=
# SAFETY: true = format & log only, nothing is ever sent. Flip to false only in Module 13.
WHATSAPP_DRY_RUN=true
# Hard caps to avoid spamming / WhatsApp bans on the test number.
MAX_MESSAGES_PER_RUN=5
MESSAGE_DELAY_SECONDS=8

# ---------- Pipeline policy ----------
# Only items scoring >= this (0-10, judged by Gemini) are eligible for WhatsApp.
MIN_RELEVANCE_SCORE=6
# Max items sent to Gemini per run: protects the daily free-tier quota (5 items = 1 request).
MAX_ANALYZE_PER_RUN=20

# ---------- Resilience ----------
# Tries per feed / Gemini call for transient errors (timeouts, 5xx, 429). 1 = never retry.
# WhatsApp sends are NEVER retried automatically (a lost reply may still be a posted message).
RETRY_MAX_ATTEMPTS=3
# First backoff delay in seconds; doubles each attempt (2, 4, 8 ...) plus random jitter.
RETRY_BASE_DELAY_SECONDS=2
# A run lock older than this many minutes is assumed to belong to a crashed run and is taken over.
RUN_LOCK_STALE_MINUTES=30

# ---------- Runtime ----------
LOG_LEVEL=INFO
# Write logs/trendwatch.log (rotating) and logs/deliveries.log (audit trail of every send). false = console only.
LOG_TO_FILE=true
LOG_DIR=logs
# Rotation: each file is capped at LOG_MAX_MB and LOG_BACKUP_COUNT older copies are kept.
LOG_MAX_MB=2
LOG_BACKUP_COUNT=5
SCHEDULE_INTERVAL_MINUTES=60
# true = scripts/scheduler.py runs a pass immediately on startup, then every interval above.
SCHEDULE_RUN_IMMEDIATELY=true
