# ===== FILE: openwa.env.example =====
# Settings for the OpenWA GATEWAY (a separate program from this project).
# `python scripts/setup_openwa.py up` copies this file to `openwa/.env` (only if that file
# does not exist yet). docker compose reads it from there, so every value below overrides
# the default in OpenWA's docker-compose.dev.yml. Edit openwa/.env, not this template,
# once the gateway has been created.
# NOTE: this is NOT the AI TrendWatch `.env`; the two files are unrelated.

# Reachable from THIS computer only. Never set 0.0.0.0 unless you understand the exposure:
# anyone who can reach the port and holds the API key controls the linked WhatsApp account.
BIND_HOST=127.0.0.1

# OpenWA's own README says whatsapp-web.js (real headless Chromium) has the LOWER ban-risk
# profile; baileys is lighter (less RAM) but easier for WhatsApp to fingerprint.
# whatsapp-web.js needs roughly 300-500 MB RAM per session.
ENGINE_TYPE=whatsapp-web.js

# Re-connect the paired session automatically after `docker compose down/up` or a reboot.
AUTO_START_SESSIONS=true

LOG_LEVEL=info

# SECURITY: do NOT set ALLOW_DEV_API_KEY=true. It seeds a publicly known admin key.
# Leave it unset so OpenWA generates a random owa_k1_... key on first start
# (stored in openwa/data/.api-key; read it with: python scripts/setup_openwa.py key).

# Anti-ban pacing knobs exist (SEND_PACING_*, RATE_LIMIT_*). AI TrendWatch already limits itself
# (MAX_MESSAGES_PER_RUN, MESSAGE_DELAY_SECONDS), so they are left at OpenWA's defaults here.
